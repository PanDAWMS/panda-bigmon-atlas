# Replace the machine-specific local.env when using OpenShift.
PRODSYS_DEVELOPMENT=false
PRODSYS_IS_TEST_SERVER=false
PRODSYS_FAKE_LOGIN_AS_USER=''
PRODSYS_USE_ORACLEDB=true
PRODSYS_LOG_MODE=console
PRODSYS_CERTIFICATE_PATH=/run/prodsys/certs/proxy.pem
PRODSYS_CERT_PEM_PATH=/run/prodsys/certs/client.pem
PRODSYS_CERT_KEY_PEM_PATH=/run/prodsys/certs/client-key.pem
PRODSYS_ATLAS_ES__CA_CERT=/run/prodsys/ca/ca.pem
PRODSYS_ATLAS_OS__CA_CERT=/run/prodsys/ca/ca.pem
PRODSYS_MONIT_ES__CA_CERT=/run/prodsys/ca/ca.pem
PRODSYS_DKB_ES7__CA_CERT=/run/prodsys/ca/ca.pem
PRODSYS_DKB_OS2__CA_CERT=/run/prodsys/ca/ca.pem
PRODSYS_ANALYSIS_SETTING_CONF__PROXY_PATH=/run/prodsys/certs/analysis-proxy.pem
PRODSYS_ANALYSIS_SETTING_CONF__BASE_SCRIPT_PATH=/opt/prodsys/scripts
# Set hosts/origins for your Route, as JSON string arrays:
# PRODSYS_ALLOWED_HOSTS='["your-route.cern.ch"]'
# PRODSYS_CSRF_TRUSTED_ORIGINS='["https://your-route.cern.ch"]'
# Directory containing tnsnames.ora, when not using the client default:
# PRODSYS_ORACLE_CONFIG_DIR=/run/prodsys/oracle
