PRODSYS_LOG_ROOT=/var/log/prodtaskdev
PRODSYS_USE_ORACLEDB=true
PRODSYS_DEVELOPMENT=true
PRODSYS_CERTIFICATE_PATH=/tmp/x509_prodsys_mon_dev
PRODSYS_CERT_PEM_PATH=/data/certdev/usercert.pem
PRODSYS_CERT_KEY_PEM_PATH=/data/certdev/userkey.pem
PRODSYS_FAKE_LOGIN_AS_USER=***
PRODSYS_ATLAS_ES__CA_CERT=/etc/pki/tls/certs/CERN-bundle.pem
PRODSYS_ATLAS_OS__CA_CERT=/etc/pki/tls/certs/CERN-bundle.pem
PRODSYS_MONIT_ES__CA_CERT=/etc/pki/tls/certs/CERN-bundle.pem
PRODSYS_DKB_ES7__CA_CERT=/etc/pki/tls/certs/CERN-bundle.pem
PRODSYS_DKB_OS2__CA_CERT=/etc/pki/tls/certs/CERN-bundle.pem
PRODSYS_ANALYSIS_SETTING_CONF__PROXY_PATH=/data/deft/alrb_development/long_mborodin_proxy
PRODSYS_ANALYSIS_SETTING_CONF__BASE_SCRIPT_PATH=/data/deft/alrb_development/
PRODSYS_IS_TEST_SERVER=true
PRODSYS_EMAIL_HOST=localhost
PRODSYS_EMAIL_PORT=1025
